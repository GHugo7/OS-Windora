#!/usr/bin/bash
# installer - installe des logiciels Fedora ET Windows, depuis Fedora (WSL) ou PowerShell.
#
#   installer firefox gimp            paquets Fedora (dnf)
#   installer setup.exe app.msi       installeurs Windows, lancés sur Windows (natif)
#   installer paquet.rpm              paquet Fedora téléchargé
#   installer --windows Steam         logiciel Windows via winget
#   installer firefox Discord.exe     tout mélangé dans une seule commande

# Le code PowerShell est écrit entre apostrophes : ses $ sont pour PowerShell, pas pour bash.
# shellcheck disable=SC2016
set -uo pipefail

PAUSE=0
FORCE_WINDOWS=0
FEDORA_PKGS=()
RPM_FILES=()
WINDOWS_FILES=()
WINGET_PKGS=()
FAILED=0

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31mErreur :\033[0m %s\n' "$*" >&2; FAILED=1; }

usage() {
    cat <<'TXT'
installer - logiciels Fedora et Windows, avec une seule commande

  installer <nom|fichier>...     installe chaque élément au bon endroit :
      nom de paquet       -> Fedora (sudo dnf install) ; sinon Windows (winget)
      fichier .rpm        -> Fedora
      fichier .exe        -> lancé sur Windows (l'installeur s'ouvre)
      fichier .msi        -> Windows Installer
      fichier .msix/.appx -> application Windows (Microsoft Store hors ligne)

  -w, --windows   les noms qui suivent sont des logiciels Windows (winget)
  -f, --fedora    les noms qui suivent sont des paquets Fedora (par défaut)
      --pause     demande confirmation et attend Entrée à la fin (double-clic sur un .rpm)
  -h, --help      cette aide

Exemples :
  installer firefox vlc
  installer ~/Téléchargements/jeu-setup.exe
  installer --windows Valve.Steam Discord.Discord
TXT
}

finish() {
    if ((PAUSE)); then
        echo
        read -r -p "Appuyez sur Entrée pour fermer..." _ || true
    fi
    exit "$FAILED"
}

# Chemin Windows (C:\...) ou relatif -> chemin Linux.
to_linux_path() {
    local p="$1"
    if [[ "$p" =~ ^[A-Za-z]:[\\/] || "$p" == \\\\* ]]; then
        wslpath -u "$p" 2>/dev/null || echo "$p"
    else
        echo "${p//\\//}"
    fi
}

# Dossier temporaire de Windows (%TEMP%), en chemin Linux.
# cmd /u écrit en UTF-16 : les noms accentués (C:\Users\Hélène) arrivent intacts.
windows_temp() {
    local t
    t="$(cd /mnt/c 2>/dev/null && cmd.exe /d /u /c 'echo %TEMP%' 2>/dev/null | iconv -f UTF-16LE -t UTF-8 | tr -d '\r\n')"
    [[ -n "$t" ]] && wslpath -u "$t"
}

# Un fichier présent dans Fedora (hors /mnt/c...) doit être copié côté Windows pour y être lancé.
windows_path_for() {
    local f="$1"
    case "$(realpath -- "$f")" in
        /mnt/[a-z]/*) wslpath -w "$f" ;;
        *)
            local dir
            dir="$(windows_temp)" || return 1
            dir="$dir/windora"
            mkdir -p -- "$dir" && cp -f -- "$f" "$dir/" && wslpath -w "$dir/$(basename -- "$f")"
            ;;
    esac
}

# Lance du code PowerShell sous Windows. La valeur ($2) passe par la variable d'environnement
# FXW_ARG, jamais dans le texte du code : un nom de fichier avec une apostrophe (y compris
# typographique, ’) ne peut ni casser la commande ni y injecter du code.
ps_run() {
    FXW_ARG="$2" WSLENV="${WSLENV:+$WSLENV:}FXW_ARG" powershell.exe -NoProfile -NonInteractive -Command "$1"
}

# Code de sortie : 0 = paquet Fedora, 1 = inconnu de Fedora, 2 = dépôts injoignables.
is_fedora_package() {
    local out
    out="$(dnf -q repoquery --latest-limit=1 -- "$1" 2>/dev/null)" || return 2
    [[ -n "$out" ]]
}

classify() {
    local item="$1" path
    path="$(to_linux_path "$item")"
    if [[ -f "$path" ]]; then
        case "${path,,}" in
            *.rpm) RPM_FILES+=("$(realpath -- "$path")") ;;
            *.exe | *.msi | *.msix | *.msixbundle | *.appx | *.appxbundle) WINDOWS_FILES+=("$path") ;;
            *) fail "type de fichier non pris en charge : $item (.rpm, .exe, .msi, .msix)" ;;
        esac
        return
    fi
    if [[ "$item" == */* || "$item" == *\\* ]]; then
        fail "fichier introuvable : $item"
        return
    fi
    if ((FORCE_WINDOWS)); then
        WINGET_PKGS+=("$item")
        return
    fi
    is_fedora_package "$item"
    case $? in
        0) FEDORA_PKGS+=("$item") ;;
        1)
            info "« $item » n'existe pas dans Fedora : recherche côté Windows (winget)."
            WINGET_PKGS+=("$item")
            ;;
        *) fail "dépôts Fedora injoignables : impossible de savoir si « $item » est un paquet Fedora (connexion Internet ?). Pour un logiciel Windows : installer --windows $item" ;;
    esac
}

install_fedora() {
    ((${#FEDORA_PKGS[@]} + ${#RPM_FILES[@]})) || return 0
    local names=("${FEDORA_PKGS[@]}" "${RPM_FILES[@]##*/}")
    info "Fedora : ${names[*]}"
    local yes=(-y)
    if ((PAUSE && ${#RPM_FILES[@]})); then
        # Double-clic sur un .rpm téléchargé : il s'installe en administrateur (root), on demande.
        warn "Un paquet .rpm s'installe avec les droits administrateur de Fedora :"
        warn "n'accepte que s'il vient d'une source de confiance."
        yes=()
    fi
    sudo dnf install "${yes[@]}" "${FEDORA_PKGS[@]}" "${RPM_FILES[@]}" || fail "l'installation Fedora a échoué ou a été annulée"
}

run_windows_file() {
    local f="$1" win
    win="$(windows_path_for "$f")" || { fail "impossible de préparer $f pour Windows"; return; }
    info "Windows : $(basename -- "$f")"
    # L'installeur s'ouvre sur le bureau Windows et on attend qu'il se termine. WaitForExit()
    # n'attend que lui (Start-Process -Wait attendrait aussi l'appli qu'il lance à la fin).
    # $p.Handle est lu tout de suite : sans cela, ExitCode serait vide une fois le processus fini.
    case "${f,,}" in
        *.exe)
            ps_run '$p = Start-Process -FilePath $env:FXW_ARG -PassThru; $null = $p.Handle; $p.WaitForExit(); exit $p.ExitCode' "$win" ;;
        *.msi)
            # [char]34 = guillemet : le chemin reste en un seul morceau pour msiexec.
            ps_run '$p = Start-Process msiexec.exe -ArgumentList ("/i " + [char]34 + $env:FXW_ARG + [char]34) -PassThru; $null = $p.Handle; $p.WaitForExit(); exit $p.ExitCode' "$win" ;;
        *)
            ps_run 'try { Add-AppxPackage -Path $env:FXW_ARG -ErrorAction Stop } catch { Write-Host $_.Exception.Message; exit 1 }' "$win" ;;
    esac
    local status=$?
    ((status == 0 || status == 3010)) || fail "$(basename -- "$f") s'est terminé avec le code $status"
    ((status == 3010)) && warn "Windows doit redémarrer pour terminer l'installation de $(basename -- "$f")."
    return 0
}

install_winget() {
    local pkg
    for pkg in "${WINGET_PKGS[@]}"; do
        info "Windows (winget) : $pkg"
        ps_run 'winget install $env:FXW_ARG --source winget --accept-package-agreements --accept-source-agreements; exit $LASTEXITCODE' "$pkg" ||
            fail "winget n'a pas pu installer « $pkg » (essayez : winget search $pkg)"
    done
}

main() {
    (($#)) || { usage; exit 1; }
    while (($#)); do
        case "$1" in
            -h | --help) usage; exit 0 ;;
            -w | --windows) FORCE_WINDOWS=1 ;;
            -f | --fedora) FORCE_WINDOWS=0 ;;
            --pause) PAUSE=1 ;;
            --) shift; for a in "$@"; do classify "$a"; done; break ;;
            -*) fail "option inconnue : $1"; finish ;;
            *) classify "$1" ;;
        esac
        shift
    done
    install_fedora
    local f
    for f in "${WINDOWS_FILES[@]}"; do run_windows_file "$f"; done
    install_winget
    ((FAILED)) || info "Terminé."
    finish
}

main "$@"
